getwd()
library(forecast)
library(fpp3)
library(ggplot2)
library(readxl)
library(feasts)
library(tseries)
setwd("C:/Users/danie/Documents/PUC/Mestrado/simulacao/dfs")
dados <- read_excel("df_geral_mes_ano.xlsx")
dados_ts <- dados |>
mutate(`Mês/ano` = yearmonth(`Mês/ano`)) |>
as_tsibble(index = `Mês/ano`)
stl_dcmp <- dados_ts |>
model(
STL(taxa ~ trend(window = 24) +
season(window = "periodic"),
robust = TRUE)
) |>
components()
stl_dcmp |> autoplot()
dados_ts |> gg_subseries(taxa) + theme_minimal()
dados_ts |> gg_season(taxa, labels = "right") +
geom_point() + theme_minimal()
dados_ts %>%
gg_tsdisplay(
difference(taxa, lag = 12) |> difference(differences = 1),
plot_type = "partial",  # <-- isso ativa o PACF no lugar do histograma
lag_max = 36
) +
labs(title = "Double Differenced", y = "")
taxa_diff <- dados_ts |>
mutate(taxa_d = difference(taxa, lag = 12) |> difference(differences = 1)) |>
drop_na()
# ACF
taxa_diff |> ACF(taxa_d, lag_max = 36) |> autoplot() + theme_minimal()
# PACF
taxa_diff |> PACF(taxa_d, lag_max = 36) |> autoplot() + theme_minimal()
# Converter para ts base (necessário para os testes)
taxa_vec <- as.numeric(dados_ts$taxa)
taxa_ts_base <- ts(taxa_vec, frequency = 12)
# --- Série original ---
cat("=== SÉRIE ORIGINAL ===\n")
adf.test(taxa_ts_base)
kpss.test(taxa_ts_base)
# --- Após diferenciação sazonal (D=1) ---
taxa_d12 <- diff(taxa_ts_base, lag = 12)
cat("\n=== APÓS DIFF SAZONAL (lag=12) ===\n")
adf.test(taxa_d12)
kpss.test(taxa_d12)
# --- Após diferenciação sazonal + não sazonal (D=1, d=1) ---
taxa_d12_d1 <- diff(taxa_d12, differences = 1)
cat("\n=== APÓS DIFF SAZONAL + NÃO SAZONAL ===\n")
adf.test(taxa_d12_d1)
kpss.test(taxa_d12_d1)
dados_treino <- dados_ts |>
filter(year(`Mês/ano`) < 2025)
pneumo_fit_ets <- dados_treino %>%
model(
ets_auto = ETS(taxa)
)
# Passo 2: veja o que ele escolheu
pneumo_fit_ets |> report()
# Previsão para 2025 (12 meses)
pneumo_fc_ets <- forecast(pneumo_fit_ets, h = 12)
# Visualizar previsão vs dados reais de 2025
pneumo_fc_ets |>
filter(.model == "ets_auto") |>
autoplot(dados_ts, level = NULL) +
labs(title = "Taxa chikungunya - Previsão 2025",
y = "Taxa")
glance(pneumo_fit_ets) |> arrange(AICc) |> select(.model:BIC)
pneumo_fit_ets |> select(ets_auto) |> gg_tsresiduals(lag = 36)
augment(pneumo_fit_ets) |>
filter(.model == "ets_auto") |>
features(.innov, ljung_box, lag = 24, dof = 3)
dados_treino <- dados_ts |>
filter(year(`Mês/ano`) < 2025)
pneumo_fit_arima <- dados_treino |>
model(
auto_arima   = ARIMA(taxa ~ pdq(0:3, 0:1, 0:3) + PDQ(0:2, 0:1, 0:2),
stepwise = F,
approximation = F),
arima202111  = ARIMA(taxa ~ pdq(2,0,2) + PDQ(1,1,1)),
arima212111  = ARIMA(taxa ~ pdq(2,1,2) + PDQ(1,1,1)),
arima202101  = ARIMA(taxa ~ pdq(2,0,2) + PDQ(1,0,1))
)
# Ver os modelos escolhidos
pneumo_fit_arima |> pivot_longer(everything(), names_to = "Model name",
values_to = "Orders")
# Comparar AICc
glance(pneumo_fit_arima) |> arrange(AICc) |> select(.model:BIC)
# Resíduos do melhor modelo
pneumo_fit_arima |> select(auto_arima) |> gg_tsresiduals(lag = 36)
# Teste Ljung-Box (dof = p+q+P+Q do modelo escolhido)
augment(pneumo_fit_arima) |>
filter(.model == "auto_arima") |>
features(.innov, ljung_box, lag = 24, dof = 6)
# Previsão 2025
forecast(pneumo_fit_arima, h = 12) |>
filter(.model == "auto_arima") |>
autoplot(dados_ts, level = NULL) +
labs(title = "Taxa Chikungunya - Previsão 2025",
y = "Taxa")
dados_ts <- dados_ts |>
mutate(
surto_2024 = if_else(year(`Mês/ano`) == 2024, 1, 0)
)
# 2. Separar treino já com as dummies
dados_treino <- dados_ts |>
filter(year(`Mês/ano`) < 2025)
# 3. Criar matrix de regressores futuros (2025)
dados_2025 <- dados_ts |>
filter(year(`Mês/ano`) == 2025)
# 4. Ajustar modelo com dummies como regressores externos
pneumo_fit_arima <- dados_treino |>
model(
auto_arima = ARIMA(taxa ~ surto_2024 +
pdq(0:3, 0:1, 0:3) + PDQ(0:2, 0:1, 0:2),
stepwise = F,
approximation = F),
arima_dummy = ARIMA(taxa ~surto_2024 +
pdq(2,0,2) + PDQ(1,1,1))
)
# 5. Comparar AICc
glance(pneumo_fit_arima) |> arrange(AICc) |> select(.model:BIC)
# 6. Previsão — passando os regressores de 2025 (ambos = 0)
forecast(pneumo_fit_arima, new_data = dados_2025) |>
filter(.model == "auto_arima") |>
autoplot(dados_ts, level = NULL) +
labs(title = "Taxa Chikungunya - Previsão 2025 (com dummies de surto)",
y = "Taxa")
# Calcular média histórica por mês (excluindo 2024)
media_mensal <- dados_treino |>
as_tibble() |>
filter(year(`Mês/ano`) != 2024) |>
mutate(mes = month(`Mês/ano`)) |>
group_by(mes) |>
summarise(media_hist = mean(taxa))
dados_ts <- dados_ts |>
as_tibble() |>
mutate(mes = month(`Mês/ano`)) |>
left_join(media_mensal, by = "mes", relationship = "many-to-one") |>
mutate(
taxa_adj = if_else(
year(`Mês/ano`) == 2024 & month(`Mês/ano`) %in% c(1,2,3,4,5),
media_hist,
taxa
)
) |>
select(-mes, -media_hist) |>
as_tsibble(index = `Mês/ano`)
# 2. Separar treino já com as dummies
dados_treino <- dados_ts |>
filter(year(`Mês/ano`) < 2025)
pneumo_fit_arima <- dados_treino |>
model(
auto_arima   = ARIMA(taxa_adj ~ pdq(0:3, 0:1, 0:3) + PDQ(0:2, 0:1, 0:2),
stepwise = F,
approximation = F),
arima202111  = ARIMA(taxa_adj ~ pdq(2,0,2) + PDQ(1,1,1)),
arima212111  = ARIMA(taxa_adj ~ pdq(2,1,2) + PDQ(1,1,1)),
arima202101  = ARIMA(taxa_adj ~ pdq(2,0,2) + PDQ(1,0,1))
)
# Ver os modelos escolhidos
pneumo_fit_arima |> pivot_longer(everything(), names_to = "Model name",
values_to = "Orders")
# Comparar AICc
glance(pneumo_fit_arima) |> arrange(AICc) |> select(.model:BIC)
# Resíduos do melhor modelo
pneumo_fit_arima |> select(auto_arima) |> gg_tsresiduals(lag = 36)
# Teste Ljung-Box (dof = p+q+P+Q do modelo escolhido)
augment(pneumo_fit_arima) |>
filter(.model == "auto_arima") |>
features(.innov, ljung_box, lag = 24, dof = 6)
# Previsão 2025
forecast(pneumo_fit_arima, h = 12) |>
filter(.model == "auto_arima") |>
autoplot(dados_ts, level = NULL) +
labs(title = "Taxa Chikungunya - Previsão 2025",
y = "Taxa")
